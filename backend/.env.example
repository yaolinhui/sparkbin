# ==========================================
# SparkBin Backend Environment Configuration
# Copy this file to .env and fill in your values
# ==========================================

# Database (SQLite or PostgreSQL)
# SQLite example (simplest for self-hosting):
DATABASE_URL=sqlite:///./sparkbin.db
# PostgreSQL example (production recommendation):
# DATABASE_URL=postgresql://user:password@localhost:5432/sparkbin

# Security Keys (MUST be changed for production!)
# Generate a strong secret key, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS

# Generate a 32-byte encryption key (must be a valid URL-safe base64 Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_BASE64

# Initial Admin Account (created on first startup)
# DEFAULT_USERNAME cannot be 'admin'. DEFAULT_PASSWORD must be 8+ chars with uppercase, lowercase, digit, and special char.
DEFAULT_USERNAME=sparkbin-admin
DEFAULT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# API Server Port
API_PORT=8000

# CORS Origins (comma-separated, no spaces)
# Add your frontend URL(s) here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Debug mode (set to false in production)
DEBUG=false

# Token expiration (optional)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public backend API URL (used in CSP connect-src)
API_URL=http://localhost:8000

# Trusted hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,api.example.com

# HSTS max age (set to 31536000 in production for HTTPS)
HSTS_MAX_AGE=0

# HTTP proxy for external API access (optional)
HTTP_PROXY=
HTTPS_PROXY=

# SaaS / Payment feature toggles
ENABLE_PAYMENTS=false
ENABLE_SAAS_FEATURES=false
CREDITS_GRANT_ON_REGISTER=20
CREDITS_PACKS=5:100,10:250,20:600

# Leave empty for self-hosted mode (no payment features)
# Test mode key starts with sk_test_
# Live mode key starts with sk_live_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
APP_URL=http://localhost:5173

# GitHub Backup Configuration (Optional)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_FILE_PATH=data/projects.json

# Email Service (Resend) - Optional, leave empty to mock emails in dev
RESEND_API_KEY=
RESEND_FROM_EMAIL=SparkBin <noreply@sparkbin.dev>

# OAuth 2.0 Configuration (Optional)
# Register apps at: https://console.cloud.google.com/ (Google) and https://github.com/settings/developers (GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
