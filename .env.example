# ==========================================
# SparkBin Environment Configuration
# Copy this file to .env and fill in values
# ==========================================

# ------------------------------
# Security (REQUIRED)
# ------------------------------
# JWT signing key - generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS

# API key encryption - must be a valid 32-byte URL-safe base64 Fernet key.
# Generate with either:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_BASE64

# Initial admin account - change immediately after first login
# DEFAULT_USERNAME cannot be 'admin'. DEFAULT_PASSWORD must be 8+ chars with uppercase, lowercase, digit, and special char.
DEFAULT_USERNAME=sparkbin-admin
DEFAULT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ------------------------------
# Database (REQUIRED)
# ------------------------------
# SQLite (development): sqlite:///./sparkbin.db
# PostgreSQL (production): postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://sparkbin:REPLACE_DB_PASSWORD@postgres:5432/sparkbin

# ------------------------------
# CORS (REQUIRED for production)
# ------------------------------
# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173,http://127.0.0.1:5173
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------
# Server
# ------------------------------
API_PORT=8000
DEBUG=false

# Token expiration (optional)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------
# Frontend Build (for Docker)
# ------------------------------
# Backend API URL injected at build time
VITE_API_URL=http://localhost:8000

# ------------------------------
# Security Headers
# ------------------------------
# Set to 31536000 (1 year) to enable HSTS in production
HSTS_MAX_AGE=0

# ------------------------------
# Public Backend URL
# ------------------------------
# Used in CSP connect-src and external links
API_URL=http://localhost:8000

# ------------------------------
# Trusted Hosts
# ------------------------------
# Comma-separated list of allowed hosts (production)
ALLOWED_HOSTS=localhost,api.example.com

# ------------------------------
# HTTP Proxy (optional)
# ------------------------------
# For servers in mainland China accessing Google/GitHub APIs
HTTP_PROXY=
HTTPS_PROXY=

# ------------------------------
# SaaS / Payment Toggles
# ------------------------------
ENABLE_PAYMENTS=false
ENABLE_SAAS_FEATURES=false
CREDITS_GRANT_ON_REGISTER=20
CREDITS_PACKS=5:100,10:250,20:600

# ------------------------------
# OAuth Login (Optional)
# ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost

# ------------------------------
# Email Service (Optional)
# ------------------------------
# For email registration and password reset
RESEND_API_KEY=
RESEND_FROM_EMAIL=SparkBin <noreply@yourdomain.com>

# ------------------------------
# Stripe Payments (Optional)
# ------------------------------
# Leave empty to disable payment features
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
APP_URL=http://localhost

# ------------------------------
# GitHub Backup (Optional)
# ------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_FILE_PATH=data/projects.json
